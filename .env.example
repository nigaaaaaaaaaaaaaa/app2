# BlockMotion AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file.

# === Supabase (pre-configured, do not change) ===
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=your-database-url

# === LLM Providers (at least one required for AI generation) ===
# To use Gemini: set GEMINI_API_KEY as a Supabase Edge Function secret
# (Supabase Dashboard → Project Settings → Edge Functions → Secrets).
# Alternatively, store the key in the ai_providers table via the AI Providers page.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# === Voice Providers ===
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
GOOGLE_TTS_KEY=

# === Music Providers ===
SUNO_API_KEY=
UDIO_API_KEY=

# === Video Providers ===
RUNWAY_API_KEY=
PIKA_API_KEY=

# === Image Providers ===
DALLE_API_KEY=
STABLE_DIFFUSION_API_KEY=

# === Rendering ===
BLENDER_PATH=/usr/bin/blender
FFMPEG_PATH=/usr/bin/ffmpeg

# === Queue / Workers ===
REDIS_URL=
WORKER_CONCURRENCY=4
WORKER_TIMEOUT=3600

# === Storage ===
STORAGE_BACKEND=supabase
STORAGE_REGION=us-east-1
